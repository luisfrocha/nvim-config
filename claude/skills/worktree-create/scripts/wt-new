#!/usr/bin/env bash
#
# wt-new — create a git worktree whose directory follows Git Tower's naming
# pattern: <repo-name>-<branch-with-slashes-as-dashes>, placed alongside the
# main repo. Works in Supacode, herdr, or a plain terminal.
#
#   branch hotfix/dashboard-activate-update in repo ~/Sites/vistara-bi-ads-ui
#   ->  ~/Sites/vistara-bi-ads-ui-hotfix-dashboard-activate-update
#
# Supacode's "Default directory" setting is a plain parent path, not a template,
# so it can't reproduce this pattern on its own. The worktree itself is made with
# native git; afterwards the detected app is told about it (Supacode: ownership
# lock; herdr: `herdr worktree open`). Run this from inside any worktree of the
# repo you want to branch from.
#
# Usage:
#   wt-new <branch> [base-ref]
#
#   <branch>    Name of the new (or existing) branch for the worktree.
#   [base-ref]  Optional ref to branch from; when given, the base is fetched
#               first. Omit to branch from the repo's default branch (origin/HEAD,
#               e.g. branch-development). Pass 'HEAD' (or '.') to branch from the
#               current HEAD instead.

set -euo pipefail

# Resolve this script's real directory even when invoked via a PATH symlink,
# then source the shared worktree helpers (kept in claude/common/).
self=${BASH_SOURCE[0]}
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case $target in
  /*) self=$target ;;
  *) self=$(dirname "$self")/$target ;;
  esac
done
script_dir=$(cd "$(dirname "$self")" && pwd)
# scripts/ -> skill dir -> skills/ -> claude/ ; common lives at claude/common.
# shellcheck source=/dev/null
. "$script_dir/../../../common/worktree.sh"

if [ "$#" -lt 1 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  echo "Usage: wt-new <branch> [base-ref]" >&2
  exit 1
fi

branch=$1
base=${2:-}

wt_detect_app
wt_resolve_repo

# Capture the worktree we're invoked from — Supacode copies ignored/untracked
# files from here into the new worktree (its copy_source_path is the current
# repo root for non-bare repos). Grab it before we create anything.
source_worktree=$(git rev-parse --show-toplevel 2>/dev/null || true)

# Default the base to the repo's mainline (origin/HEAD, e.g. branch-development)
# when not given, so new worktrees branch off the trunk rather than whatever HEAD
# happens to be. origin/HEAD is set at clone time; if it's missing, ask the remote
# once. Leave base empty (-> current HEAD) only if it can't be discovered.
if [ -z "$base" ]; then
  default_ref=$(git symbolic-ref --short -q refs/remotes/origin/HEAD || true)
  if [ -z "$default_ref" ]; then
    git remote set-head origin --auto >/dev/null 2>&1 || true
    default_ref=$(git symbolic-ref --short -q refs/remotes/origin/HEAD || true)
  fi
  base=${default_ref#origin/}
fi

target=$(wt_target_path "$branch")

if [ -e "$target" ]; then
  echo "wt-new: '$target' already exists; aborting." >&2
  exit 1
fi

# Emit the Supacode lock reason, reused from any existing supacode-locked
# worktree so build/version stay correct across Supacode upgrades, stamped with
# a current createdAt. Falls back to owner-only if no existing lock is found.
wt_supacode_lock_json() {
  local common sample build='' version='' now
  common=$(git rev-parse --git-common-dir 2>/dev/null) || return 1
  now=$(date +%s)
  for sample in "$common"/worktrees/*/locked; do
    [ -f "$sample" ] || continue
    grep -q '"owner":"supacode"' "$sample" || continue
    build=$(sed -E 's/.*"build":"([^"]*)".*/\1/' "$sample")
    version=$(sed -E 's/.*"version":"([^"]*)".*/\1/' "$sample")
    break
  done
  if [ -n "$build" ] && [ -n "$version" ]; then
    printf '{"build":"%s","createdAt":%s,"owner":"supacode","version":"%s"}' "$build" "$now" "$version"
  else
    printf '{"createdAt":%s,"owner":"supacode"}' "$now"
  fi
}

# Copy the source worktree's ignored + untracked files into the new worktree,
# mirroring Supacode (copyIgnored + copyUntracked). Everything is copied as-is —
# no exclusion heuristic — via APFS reflinks (cp -c): independent copy-on-write
# clones that cost ~no disk until modified (real-copy fallback on non-APFS).
# A big node_modules still takes ~30s of per-file cloning, so we render a real
# progress bar: cp -v prints one line per item, so counting those lines against
# an upfront item total gives an accurate percentage with no tree-polling.
copy_worktree_extras() {
  local src=$1 dst=$2 rel parent list total=0 tty=0
  [ -t 1 ] && tty=1
  list=$( {
    git -C "$src" ls-files --others --ignored --exclude-standard --directory
    git -C "$src" ls-files --others --exclude-standard --directory
  } 2>/dev/null | sed -e 's:/*$::' -e '/^\.git$/d' -e '/^$/d' | LC_ALL=C sort -u )
  [ -n "$list" ] || return 0

  # Total items to copy (files + dirs) = the number of lines cp -v will emit.
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    [ -e "$src/$rel" ] || continue
    total=$((total + $(find "$src/$rel" 2>/dev/null | wc -l)))
  done <<EOF
$list
EOF
  [ "$total" -gt 0 ] || return 0

  # Stream each entry's copy with -v; the caller pipes this into the bar counter.
  run_copies() {
    local rel parent
    while IFS= read -r rel; do
      [ -n "$rel" ] || continue
      [ -e "$src/$rel" ] || continue
      parent=$(dirname "$rel")
      mkdir -p "$dst/$parent"
      if [ -d "$src/$rel" ]; then
        cp -cRpv "$src/$rel" "$dst/$parent/" 2>/dev/null || cp -Rpv "$src/$rel" "$dst/$parent/" 2>/dev/null
      else
        cp -cpv "$src/$rel" "$dst/$rel" 2>/dev/null || cp -pv "$src/$rel" "$dst/$rel" 2>/dev/null
      fi
    done <<INNER
$list
INNER
  }

  if [ "$tty" -eq 1 ]; then
    local width=30 done=0 pct filled bar
    run_copies | {
      while IFS= read -r _; do
        done=$((done + 1))
        if [ $((done % 500)) -eq 0 ] || [ "$done" -ge "$total" ]; then
          pct=$((done * 100 / total)); [ "$pct" -gt 100 ] && pct=100
          filled=$((pct * width / 100))
          bar=$(printf '%*s' "$filled" '' | tr ' ' '#')
          printf '\r  copying [%-*s] %3d%% (%d/%d)\033[K' "$width" "$bar" "$pct" "$done" "$total"
        fi
      done
      bar=$(printf '%*s' "$width" '' | tr ' ' '#')
      printf '\r  copied  [%s] 100%% (%d items) from %s\033[K\n' "$bar" "$total" "$(basename "$src")"
    } || true
  else
    run_copies >/dev/null 2>&1 || true
    echo "  copied $total ignored/untracked item(s) from $(basename "$src")"
  fi
}

echo "Creating worktree"
echo "  branch:   $branch"
echo "  base:     ${base:-<current HEAD>}"
echo "  path:     $target"
echo "  app:      $WT_APP"

# Create the worktree with native git (synchronous — no supacode daemon race).
# --no-track is the key fix: when branching from a remote-tracking base (e.g.
# origin/branch-development) git would otherwise auto-record it as this branch's
# upstream, which is the footgun that makes a GUI/no-arg push land on the base
# branch. --no-track leaves the upstream unset; we set the correct one below.
if git show-ref --verify --quiet "refs/heads/$branch"; then
  # Branch already exists -> just attach a worktree to it.
  git worktree add "$target" "$branch"
else
  start=HEAD
  if [ -n "$base" ] && [ "$base" != "HEAD" ] && [ "$base" != "." ]; then
    # Fetch the base so we branch from its latest state (mirrors the old --fetch),
    # and prefer the freshly-fetched remote ref when the base names a remote branch.
    git fetch origin "$base" 2>/dev/null || true
    if git show-ref --verify --quiet "refs/remotes/origin/$base"; then
      start="origin/$base"
    else
      start="$base"
    fi
  fi
  git worktree add --no-track -b "$branch" "$target" "$start"
fi

# Upstream: track origin/<branch> if it already exists on the remote, otherwise
# leave it unset so the first `git push -u origin <branch>` sets it correctly.
# Never the base branch — that was the bug.
if git -C "$target" rev-parse --verify -q "refs/remotes/origin/$branch" >/dev/null; then
  git -C "$target" branch --set-upstream-to="origin/$branch" "$branch"
  echo "  upstream: origin/$branch"
else
  git -C "$target" branch --unset-upstream "$branch" 2>/dev/null || true
  echo "  upstream: (none — set on first 'git push -u origin $branch')"
fi

# Bring over ignored/untracked files (.env, local config, etc.) from the source
# worktree, as Supacode does.
if [ -n "$source_worktree" ] && [ "$source_worktree" != "$target" ]; then
  copy_worktree_extras "$source_worktree" "$target"
fi

# Tell the detected app about the new worktree.
#  - Supacode: mark it Supacode-owned (same lock reason the supacode CLI writes)
#    so the app recognizes it as one of its worktrees.
#  - herdr: register the checkout as a workspace. A failure here is not fatal —
#    the git worktree already exists and can be opened from herdr afterwards.
case $WT_APP in
supacode) git worktree lock --reason "$(wt_supacode_lock_json)" "$target" ;;
herdr)
  herdr worktree open --cwd "$WT_MAIN_ROOT" --path "$target" --focus ||
    echo "wt-new: worktree created, but 'herdr worktree open' failed — open it from herdr manually." >&2
  ;;
esac

echo "Done."
[ "$WT_APP" = supacode ] && echo "Note: press Cmd-Shift-R in Supacode if the new worktree isn't in the sidebar yet."
exit 0
