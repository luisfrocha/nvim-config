#!/usr/bin/env bash
#
# supacode-wt — create a Supacode git worktree whose directory follows Git
# Tower's naming pattern: <repo-name>-<branch-with-slashes-as-dashes>, placed
# alongside the main repo.
#
#   branch hotfix/dashboard-activate-update in repo ~/Sites/vistara-bi-ads-ui
#   ->  ~/Sites/vistara-bi-ads-ui-hotfix-dashboard-activate-update
#
# Supacode's "Default directory" setting is a plain parent path, not a template,
# so it can't reproduce this pattern on its own. Run this from inside any
# worktree of the repo you want to branch from.
#
# Usage:
#   supacode-wt <branch> [base-ref]
#
#   <branch>    Name of the new (or existing) branch for the worktree.
#   [base-ref]  Optional ref to branch from; when given, the base is fetched
#               first. Omit to branch from the current HEAD.

set -euo pipefail

# Resolve this script's real directory even when invoked via a PATH symlink,
# then source the shared worktree helpers (kept in claude/common/).
self=${BASH_SOURCE[0]}
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case $target in
  /*) self=$target ;;
  *) self=$(dirname "$self")/$target ;;
  esac
done
script_dir=$(cd "$(dirname "$self")" && pwd)
# scripts/ -> skill dir -> skills/ -> claude/ ; common lives at claude/common.
# shellcheck source=/dev/null
. "$script_dir/../../../common/worktree.sh"

if [ "$#" -lt 1 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  echo "Usage: supacode-wt <branch> [base-ref]" >&2
  exit 1
fi

branch=$1
base=${2:-}

wt_require_supacode
wt_resolve_repo

folder=$(wt_folder_name "$branch")
target=$(wt_target_path "$branch")

if [ -e "$target" ]; then
  echo "supacode-wt: '$target' already exists; aborting." >&2
  exit 1
fi

echo "Creating worktree"
echo "  branch:   $branch"
echo "  base:     ${base:-<current HEAD>}"
echo "  path:     $target"

args=(repo worktree-new --branch "$branch" --location "$WT_PARENT_DIR" --name "$folder")
if [ -n "$base" ]; then
  args+=(--base "$base" --fetch)
fi

exec supacode "${args[@]}"
